{
    "name": "friendsofredaxo/quick_navigation",
    "description": "Befehlspalette für das REDAXO-6-Backend: Live-Suche über Seiten, Struktur, Medien und mehr – mit ⌘K/Strg+K aus der Kopfleiste, nach den Rechten des Benutzers, erweiterbar durch andere AddOns",
    "type": "redaxo-addon",
    "license": "MIT",
    "keywords": [
        "redaxo",
        "redaxo-addon",
        "redaxo6",
        "backend",
        "search",
        "command-palette"
    ],
    "homepage": "https://github.com/FriendsOfREDAXO/quick_navigation",
    "authors": [
        {
            "name": "Thomas Skerbis",
            "homepage": "https://github.com/skerbis",
            "role": "Lead"
        },
        {
            "name": "Friends Of REDAXO",
            "homepage": "https://friendsofredaxo.github.io"
        }
    ],
    "support": {
        "issues": "https://github.com/FriendsOfREDAXO/quick_navigation/issues",
        "source": "https://github.com/FriendsOfREDAXO/quick_navigation"
    },
    "require": {
        "php": "^8.5",
        "redaxo/core": "^6.0@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5 || ^13.1"
    },
    "autoload": {
        "psr-4": {
            "FriendsOfRedaxo\\QuickNavigation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FriendsOfRedaxo\\QuickNavigation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "redaxo": {
            "addon-class": "FriendsOfRedaxo\\QuickNavigation\\QuickNavigationAddon"
        },
        "branch-alias": {
            "dev-main": "10.x-dev"
        }
    }
}
